pipeline {
  agent any
  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    disableConcurrentBuilds()
  }
  parameters {
    string(name: 'LAB_REPO', defaultValue: 'https://github.com/jgflStucom/WebsVulnerables',
           description: 'Repositorio del laboratorio a analizar')
    choice(name: 'ZAP_MODE', choices: ['baseline', 'full'],
           description: 'baseline = pasivo; full = escaneo activo autenticado')
  }
  environment {
    SEMGREP_IMAGE = 'semgrep/semgrep:latest'
    ZAP_IMAGE     = 'ghcr.io/zaproxy/zaproxy:stable'
  }
  stages {
    stage('Checkout') {
      steps {
        sh """
          set -e
          echo "Repositorio a analizar: ${params.LAB_REPO}"
          test -n "${params.LAB_REPO}" || { echo "LAB_REPO vacio"; exit 2; }
          rm -rf lab zap compose.ci.yml semgrep.json semgrep.sarif semgrep.txt
          git clone --depth 1 "${params.LAB_REPO}" lab
        """
      }
    }
    stage('SAST Semgrep') {
      steps {
        sh '''
          docker run --rm --volumes-from jenkins -w "$WORKSPACE" ${SEMGREP_IMAGE} \
            semgrep scan --config p/php --config p/owasp-top-ten --metrics=off \
            --exclude db_data \
            --json-output=semgrep.json --sarif-output=semgrep.sarif --text-output=semgrep.txt \
            --error --text lab || true
        '''
      }
    }
    stage('Gate SAST') {
      steps {
        archiveArtifacts artifacts: 'semgrep.*', fingerprint: true
        recordIssues(
          tools: [sarif(pattern: 'semgrep.sarif', id: 'semgrep', name: 'Semgrep')],
          enabledForFailure: true
        )
        sh '''
          N=$(grep -o '"ruleId"' semgrep.json | wc -l | tr -d ' ')
          echo "Hallazgos SAST: $N"
          if [ "$N" -gt 0 ]; then
            echo "Gate SAST: $N hallazgo(s) bloqueante(s). Despliegue cancelado."
            exit 1
          fi
        '''
      }
    }
    stage('Desplegar laboratorio') {
      steps {
        sh '''
          cat > compose.ci.yml <<'YAML'
services:
  db1: { container_name: ci_mysql_examen_1, restart: "no" }
  db2: { container_name: ci_mysql_examen_2, restart: "no" }
  db3: { container_name: ci_mysql_examen_3, restart: "no" }
  db4: { container_name: ci_mysql_examen_4, restart: "no" }
  web1: { container_name: ci_web_examen_1, ports: !override ["55340:80"] }
  web2: { container_name: ci_web_examen_2, ports: !override ["55350:80"] }
  web3: { container_name: ci_web_examen_3, ports: !override ["55360:80"] }
  web4: { container_name: ci_web_examen_4, ports: !override ["55370:80"] }
YAML
          docker compose -p examenweb-ci -f lab/ExamenWeb/docker-compose.yml -f compose.ci.yml up -d --build
          for n in 1 2 3 4; do
            for i in $(seq 1 30); do
              docker exec ci_mysql_examen_$n mysqladmin ping -uroot -proot_pass_examen$n --silent 2>/dev/null && break
              sleep 2
            done
          done
          echo "Comprobando los sitios..."
          for p in 55340 55350 55360 55370; do
            printf "  sitio %s -> " "$p"
            code=$(docker run --rm --network host ${ZAP_IMAGE} curl -s -o /dev/null -w "%{http_code}" "http://localhost:$p/")
            echo "$code"
          done
        '''
      }
    }
    stage('DAST ZAP autenticado') {
      steps {
        script {
          sh 'rm -rf zap && mkdir -p zap && chmod 777 zap'

          def plantilla = '''env:
contexts:
  - name: '__SITE__'
    urls: ['http://localhost:__PORT__']
    includePaths: ['http://localhost:__PORT__.*']
    excludePaths: ['http://localhost:__PORT__/__LOGOUT__.*']
    authentication:
      method: 'form'
      parameters:
        loginPageUrl: 'http://localhost:__PORT__/__LOGIN__'
        loginRequestUrl: 'http://localhost:__PORT__/__LOGIN__'
        loginRequestBody: '__BODY__'
      verification:
        method: 'response'
        loggedInRegex: '__DENTRO__'
        loggedOutRegex: '__FUERA__'
    sessionManagement:
      method: 'cookie'
    users:
      - name: 'usuario'
        credentials:
          username: '${ZAP_USER}'
          password: '${ZAP_PASS}'
jobs:
  - type: 'spider'
    parameters: { context: '__SITE__', user: 'usuario', maxDuration: 2 }
  - type: 'passiveScan-wait'
__ACTIVE__
  - type: 'report'
    parameters: { template: 'traditional-html', reportDir: '/zap/wrk', reportFile: '__SITE__', reportTitle: 'ZAP __SITE__' }
  - type: 'report'
    parameters: { template: 'traditional-json', reportDir: '/zap/wrk', reportFile: '__SITE__', reportTitle: 'ZAP __SITE__' }
'''

          def bloqueActivo = '''
  - type: 'activeScan'
    parameters: { context: '__SITE__', user: 'usuario', maxScanDurationInMins: 10 }'''

          def sitios = [
            [n:'sitio1', p:'55340', c:'zap-sitio1', login:'index.php',
             body:'user={%username%}&pass={%password%}', dentro:'logout', fuera:'name="pass"', logout:'logout.php'],
            [n:'sitio2', p:'55350', c:'zap-sitio2', login:'login.php',
             body:'username={%username%}&password={%password%}', dentro:'logout', fuera:'name="password"', logout:'logout.php'],
            [n:'sitio3', p:'55360', c:'zap-sitio3', login:'login.php',
             body:'username={%username%}&password={%password%}', dentro:'logout', fuera:'name="password"', logout:'login.php?logout=1'],
          ]

          sitios.each { s ->
            def plan = plantilla
              .replace('__SITE__', s.n)
              .replace('__PORT__', s.p)
              .replace('__LOGIN__', s.login)
              .replace('__BODY__', s.body)
              .replace('__DENTRO__', s.dentro)
              .replace('__FUERA__', s.fuera)
              .replace('__LOGOUT__', s.logout)
              .replace('__ACTIVE__', params.ZAP_MODE == 'full' ? bloqueActivo.replace('__SITE__', s.n) : '')

            writeFile file: "zap/plan-${s.n}.yaml", text: plan

            withCredentials([usernamePassword(credentialsId: s.c, usernameVariable: 'ZAP_USER', passwordVariable: 'ZAP_PASS')]) {
              sh """
                docker run --rm --name ci_zap --network host -e ZAP_USER -e ZAP_PASS \\
                  -v "\$WORKSPACE/zap":/zap/wrk:rw ${ZAP_IMAGE} \\
                  zap.sh -cmd -port 8099 -autorun /zap/wrk/plan-${s.n}.yaml || true
              """
            }
          }
        }
      }
    }
    stage('Gate DAST') {
      steps {
        archiveArtifacts artifacts: 'zap/*.html,zap/*.json,semgrep.*', fingerprint: true
        script {
          def rc = sh(returnStatus: true, script: '''
            H=0
            for f in zap/*.json; do
              n=$(grep -o '"riskcode": *"3"' "$f" | wc -l | tr -d ' ')
              m=$(grep -o '"riskcode": *"2"' "$f" | wc -l | tr -d ' ')
              echo "$(basename "$f"): High=$n Medium=$m"
              H=$((H+n))
            done
            echo "TOTAL High: $H"
            if [ "$H" -gt 0 ]; then
              echo "Gate DAST: $H alerta(s) de riesgo alto. Despliegue bloqueado."
              exit 1
            fi
          ''')
          if (rc == 1) { error('Gate DAST: alertas de riesgo alto. Despliegue bloqueado.') }
          else if (rc != 0) { error("El gate DAST fallo con codigo ${rc}") }
        }
      }
    }
    stage('Informes') {
      steps {
        publishHTML(target: [
          reportName: 'ZAP DAST',
          reportDir: 'zap',
          reportFiles: 'sitio1.html,sitio2.html,sitio3.html',
          reportTitles: 'Sitio 1,Sitio 2,Sitio 3',
          keepAll: true,
          alwaysLinkToLastBuild: true,
          allowMissing: true
        ])
      }
    }
  }
  post {
    always {
      sh '''
        docker compose -p examenweb-ci -f lab/ExamenWeb/docker-compose.yml -f compose.ci.yml down --remove-orphans 2>/dev/null || true
        docker rm -f ci_zap 2>/dev/null || true
      '''
    }
  }
}
